FROM node:20-alpine AS builder

WORKDIR /app

RUN apk add --no-cache python3 make g++

COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
COPY packages/ ./packages/

RUN npm ci --workspace=apps/api

COPY apps/api/ ./apps/api/
COPY tsconfig.base.json ./

RUN npm run build --workspace=@forge/shared-types \
  && npm run build --workspace=apps/api

# --- Production stage ---
FROM node:20-alpine AS runner

WORKDIR /app

# H-B2: production transcode path is Mux (VIDEO_TRANSCODE_PROVIDER=mux, set in
# fly.worker.toml [env] and apps/api/.env.production.example). ffmpeg is opt-in
# (INCLUDE_FFMPEG=true) so the shipped worker image stays lean; local dev without
# Mux can rebuild with --build-arg INCLUDE_FFMPEG=true.
ARG INCLUDE_FFMPEG=false
RUN if [ "$INCLUDE_FFMPEG" = "true" ]; then apk add --no-cache ffmpeg; fi
RUN apk add --no-cache curl

ENV NODE_ENV=production

COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
COPY packages/shared-types/package.json ./packages/shared-types/

RUN npm ci --workspace=apps/api --omit=dev

RUN addgroup -g 1001 -S nodejs && adduser -S -u 1001 -G nodejs nestjs

COPY --from=builder --chown=nestjs:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=nestjs:nodejs /app/packages/shared-types/dist ./packages/shared-types/dist

RUN test -f apps/api/dist/apps/api/src/main.js

COPY --chown=nestjs:nodejs apps/api/docker-entrypoint.sh ./apps/api/docker-entrypoint.sh
RUN chmod +x apps/api/docker-entrypoint.sh

USER nestjs

# No continuous HEALTHCHECK. Worker still serves GET /health on PORT after boot
# for manual / on-demand diagnostics (see main.ts bootstrapWorker).

CMD ["apps/api/docker-entrypoint.sh"]
