# FORGE API — staging environment template (no secrets)
# See docs/operations/STAGING.md

NODE_ENV=production
PORT=3001

# Neon staging branch (pooled URL)
DATABASE_URL=postgresql://USER:PASS@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

REDIS_URL=rediss://default:TOKEN@staging-redis.example:6379

JWT_SECRET=generate-with-openssl-rand-base64-64
JWT_REFRESH_SECRET=generate-separate-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Staging Mux environment (not production keys)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
VIDEO_TRANSCODE_PROVIDER=mux

# Optional AWS staging bucket
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=forge-media-staging

WEB_URL=https://your-staging-web.vercel.app
ADMIN_URL=https://your-staging-admin.vercel.app

METRICS_ENABLED=true
# METRICS_SCRAPE_TOKEN=

FEATURE_FLAGS=multipart_upload

MOCK_SUBSCRIPTIONS_ENABLED=true
