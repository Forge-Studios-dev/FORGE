{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": { "allowJs": true } }]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!uuid/)"
  ],
  "moduleNameMapper": {
    "^@forge/shared-types$": "<rootDir>/../../../packages/shared-types/src/index.ts",
    "^@forge/shared-types/(.*)$": "<rootDir>/../../../packages/shared-types/src/$1"
  },
  "testTimeout": 120000
}
