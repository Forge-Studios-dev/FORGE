# Production API (used with docker-compose.prod as apps/api/.env.production or real deployment)
NODE_ENV=production
PORT=3001

# Neon (recommended for Fly.io): pooled URL from https://console.neon.tech
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DB_POOL_MAX=10

# Or Docker Compose Postgres:
# DATABASE_URL=postgresql://forge:change_me_strong_password@postgres:5432/forge_db

# Must match Redis service: use password in URL when Redis uses requirepass
REDIS_URL=redis://:change_me_redis_password@redis:6379
REDIS_PASSWORD=change_me_redis_password

JWT_SECRET=replace-with-openssl-rand-base64-64
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-different-openssl-rand-value
JWT_REFRESH_EXPIRES_IN=7d

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=forge-media-prod
CLOUDFRONT_DOMAIN=https://your-cdn.example.com

MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
VIDEO_TRANSCODE_PROVIDER=mux
MUX_INGEST_URL_TTL_SEC=43200

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

WEB_URL=https://forge.app
ADMIN_URL=https://admin.forge.app
