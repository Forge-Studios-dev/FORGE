# App
NODE_ENV=development
PORT=3001
# Set to true for BullMQ worker-only process (no HTTP listener)
# WORKER_ONLY=false
# Run FFmpeg consumer on API (local dev only — use separate worker in production)
# ENABLE_VIDEO_WORKER=false
# Allow 500MB proxy upload through API (never in production without explicit opt-in)
# ALLOW_PROXY_UPLOAD=false
# Redis TLS certificate verification (default: strict in production)
# REDIS_TLS_REJECT_UNAUTHORIZED=true

# Comma-separated feature flags (also exposed at GET /api/v1/platform/config)
# FEATURE_FLAGS=multipart_upload,blueprints_public
# multipart_upload — S3 multipart for video files >= 50MB

# OpenTelemetry (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=forge-api

# Database — pick ONE:
#
# A) Local Docker Postgres (default):
DATABASE_URL=postgresql://forge:forge_local_password@localhost:5432/forge_db
#
# B) Neon (https://neon.tech) — use Pooled connection from console, include sslmode=require:
# DATABASE_URL=postgresql://USER:PASS@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DB_POOL_MAX=10
# See apps/api/.env.neon.example and: bash scripts/neon-db-setup.sh
#
# Optional PgBouncer (local docker-compose, host port 6432):
# DATABASE_URL=postgresql://forge:forge_local_password@localhost:6432/forge_db

# Observability (optional)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_TRACES_SAMPLE_RATE=0
# METRICS_ENABLED=true
# METRICS_SCRAPE_TOKEN=   # optional; when set, GET /metrics requires Authorization: Bearer <token> (Grafana Cloud scrape)

# OR individual fields:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=forge
DB_PASSWORD=forge_local_password
DB_NAME=forge_db

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional if REDIS_URL has no password (e.g. Docker Compose prod uses requirepass)
REDIS_PASSWORD=

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=forge-media-dev
CLOUDFRONT_DOMAIN=https://d1234abcd.cloudfront.net

# Mux (https://dashboard.mux.com)
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
MUX_WEBHOOK_SECRET=your-mux-webhook-signing-secret

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# Email (optional — password reset & verification log to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@localhost

# OAuth flags (optional future Google sign-in)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
