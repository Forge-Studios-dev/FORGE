# App
NODE_ENV=development
PORT=3001
# Set to true for BullMQ worker-only process (no HTTP listener)
# WORKER_ONLY=false
# Run FFmpeg consumer on API (local dev only — use separate worker in production)
# ENABLE_VIDEO_WORKER=false
# Allow 500MB proxy upload through API (never in production without explicit opt-in)
# ALLOW_PROXY_UPLOAD=false
# Redis TLS certificate verification (default: strict in production)
# REDIS_TLS_REJECT_UNAUTHORIZED=true

# Comma-separated feature flags (also exposed at GET /api/v1/platform/config)
# FEATURE_FLAGS=multipart_upload,blueprints_public
# multipart_upload — S3 multipart for video files >= 50MB
# community_channels_deprecated — hide channels[] from community payload; block channel CRUD (returns 410)

# Skill-economy LMS extension layer (courses/cohorts/lessons/quizzes/certificates)
# Default off — YouTube-replica mode. Direct env boolean, not part of FEATURE_FLAGS.
# FEATURES_SKILL_ECONOMY_LMS=false

# OpenTelemetry (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=forge-api

# Database — pick ONE:
#
# A) Local Docker Postgres (default):
DATABASE_URL=postgresql://forge:forge_local_password@localhost:5432/forge_db
#
# B) Neon (https://neon.tech) — use Pooled connection from console, include sslmode=require:
# DATABASE_URL=postgresql://USER:PASS@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DB_POOL_MAX=5  # Neon production default; use 10 if p95 latency degrades
# DB_POOL_IDLE_TIMEOUT_MS=120000
# See apps/api/.env.neon.example and: bash scripts/neon-db-setup.sh
#
# Optional PgBouncer (local docker-compose, host port 6432):
# DATABASE_URL=postgresql://forge:forge_local_password@localhost:6432/forge_db

# Observability (optional)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_SEND_DEFAULT_PII=false
# METRICS_ENABLED=true
# METRICS_SCRAPE_TOKEN=   # optional; when set, GET /metrics requires Authorization: Bearer <token> (Grafana Cloud scrape)

# LiveKit (browser go-live → RTMP egress to Mux)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Billing provider: "stub" (fake payments, dev/staging only) or "stripe".
# The stub provider is only permitted where MOCK_SUBSCRIPTIONS_ENABLED=true
# (dev/staging). In real production (mock subscriptions off) the API refuses to
# boot unless BILLING_PROVIDER=stripe and STRIPE_SECRET_KEY are set.
# BILLING_PROVIDER=stub
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CONNECT_REFRESH_URL=https://forgestudios.net/studio/memberships
# STRIPE_PLATFORM_FEE_PERCENT=10
# Production runbook: docs/operations/STRIPE_PRODUCTION_ENABLEMENT.md
# Fly: bash scripts/set-stripe-secrets-fly.sh

# Stream chat async ingest (default on in production)
# STREAM_CHAT_ASYNC=true
# AI chat moderation (OpenAI Moderation API when OPENAI_API_KEY set)
# STREAM_AI_MODERATION_ENABLED=true
# OPENAI_API_KEY=sk-...
# Community async LLM moderation judge tail (AI-LLM-STRATEGY Phase I; requires OPENAI_API_KEY)
# AI_MODERATION_LLM_ENABLED=true
# Only LLM-judge messages whose fast-path score is at/above this (cost guard, 0-1)
# AI_MODERATION_REVIEW_THRESHOLD=0.25
# Creator copilot (discussion summaries via OpenAI chat completions)
# AI_COPILOT_ENABLED=true
# AI_COPILOT_MODEL=gpt-4.1-mini
# Claude-powered creator insights copilot (CEOS-P12-T017)
# ANTHROPIC_API_KEY=sk-ant-...
# AI_CLAUDE_ENABLED=true
# AI_CLAUDE_MODEL=claude-haiku-4-5-20251001
# Daily cost ceiling: max LLM calls per UTC day across all AI features (0 = unlimited)
# AI_DAILY_LLM_BUDGET=5000
# Super chat / tips (Stripe one-off checkout when billing enabled)
# STREAM_SUPER_CHAT_ENABLED=true
# STREAM_SUPER_CHAT_MIN_CENTS=100
# STREAM_SUPER_CHAT_MAX_CENTS=50000
# Stream analytics snapshot retention (days; 0 disables)
# STREAM_SNAPSHOT_RETENTION_DAYS=90
# DISABLE_STREAM_SNAPSHOT_RETENTION=true

# Analytics retention (F-504) — daily BullMQ job on worker; 0 or DISABLE_ANALYTICS_RETENTION=true to disable
# ANALYTICS_RETENTION_DAYS=90
# ANALYTICS_RETENTION_BATCH_SIZE=5000

# OR individual fields:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=forge
DB_PASSWORD=forge_local_password
DB_NAME=forge_db

# Redis — local Docker, or Redis Cloud (see apps/api/.env.redis-cloud.example)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional if REDIS_URL has no password (e.g. Docker Compose prod uses requirepass)
REDIS_PASSWORD=

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d
# HttpOnly refresh cookie domain (production cross-subdomain: .forgestudios.net)
# AUTH_REFRESH_COOKIE_DOMAIN=.forgestudios.net

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=forge-media-dev
CLOUDFRONT_DOMAIN=https://d1234abcd.cloudfront.net
# Set to switch S3 auth to Fly-OIDC/STS federation instead of the static keys
# above (only works when running on Fly, needs the AWS-side IAM setup in
# docs/operations/AWS_CREDENTIAL_ROTATION.md).
# AWS_ROLE_ARN=arn:aws:iam::<account-id>:role/forge-fly-media

# Mux (https://dashboard.mux.com) — store production values via Fly secrets only
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
MUX_WEBHOOK_SECRET=your-mux-webhook-signing-secret
# Signed playback for restricted live streams (Mux dashboard → Settings → Signing Keys)
# MUX_SIGNING_KEY_ID=
# MUX_SIGNING_PRIVATE_KEY=
# MUX_SIGNED_PLAYBACK_TTL_SEC=3600
# MUX_IDLE_GRACE_SEC=60
# VOD transcode: mux (Mux Video HLS/ABR, production) or ffmpeg (local dev without Mux)
VIDEO_TRANSCODE_PROVIDER=mux
MUX_INGEST_URL_TTL_SEC=43200

# Live platform workers (production: deploy WORKER_ONLY=true Fly process)
# Required queues: stream-chat-ingest, stream-reminder, stream-snapshot-retention, stream-mux-sync
# STREAM_CHAT_ASYNC=true
# STREAM_SNAPSHOT_RETENTION_DAYS=90
# DISABLE_STREAM_MUX_SYNC=false
# Sync worker secrets from API: ./scripts/sync-fly-worker-secrets.sh

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# Email (optional — password reset & verification log to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@localhost

# Auth hardening (optional)
# AUTH_EMAIL_OTP_ENABLED=false
# AUTH_REQUIRE_VERIFIED_LOGIN=false
# AUTH_LOCKOUT_MAX_ATTEMPTS=10
# AUTH_LOCKOUT_WINDOW_SEC=900
# AUTH_LOCKOUT_LOCKOUT_SEC=1800

# TOTP MFA (optional) — base64-encoded 32-byte AES-256-GCM key.
# Required before any user can enroll in MFA. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MFA_ENCRYPTION_KEY=

# Upload content-safety scanning (optional). Default 'none' approves every
# upload (today's behavior). 'webhook' POSTs {videoId,userId,hlsUrl,thumbnailUrl}
# to CONTENT_SCAN_WEBHOOK_URL and expects {action:"approve"|"hold"|"block"}
# back; any error/timeout/unrecognized response fails closed to "hold".
# CONTENT_SCAN_PROVIDER=none
# CONTENT_SCAN_WEBHOOK_URL=
# CONTENT_SCAN_WEBHOOK_TOKEN=
# CONTENT_SCAN_TIMEOUT_MS=15000

# Google OAuth (Passport — not Firebase Auth)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
WEB_OAUTH_SUCCESS_URL=http://localhost:3000/auth/oauth/callback
GOOGLE_OAUTH_MOBILE_SUCCESS_URL=forge://oauth-callback

# Firebase Admin (FCM + App Check verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FCM_ENABLED=false
# Push worker consumes push-dispatch on Fly worker (WORKER_ONLY=true); API enqueues only in production
APP_CHECK_ENABLED=false

# Entitlements (mock memberships without payment — enabled by default in non-production)
# MOCK_SUBSCRIPTIONS_ENABLED=true
# Hourly BullMQ job: expire subs + notify expiring (API registers scheduler; Fly worker consumes)
# DISABLE_SUBSCRIPTION_MAINTENANCE=true
