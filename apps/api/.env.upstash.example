# Upstash Redis — paste from https://console.upstash.com → your database → REST API
# FORGE derives REDIS_URL (rediss://) for BullMQ + ioredis from these two values.

UPSTASH_REDIS_REST_URL=https://YOUR-ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Optional: override with explicit Redis protocol URL from "Redis Connect" tab:
# REDIS_URL=rediss://default:TOKEN@YOUR-ENDPOINT.upstash.io:6379
