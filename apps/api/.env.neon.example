# Neon Postgres — copy connection string from https://console.neon.tech
# Dashboard → your project → Connect → use "Pooled connection" (recommended for Fly/serverless)

NODE_ENV=development
PORT=3001

# Paste your pooled connection string (must include sslmode=require):
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Neon: smaller pool on free tier
DB_POOL_MAX=10

# Comment out or remove local DB_* when using DATABASE_URL
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=forge
# DB_PASSWORD=forge_local_password
# DB_NAME=forge_db

# Redis — Upstash (see apps/api/.env.upstash.example) or local Docker
# UPSTASH_REDIS_REST_URL=https://YOUR-ENDPOINT.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
