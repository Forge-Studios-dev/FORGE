# Neon Postgres — copy connection string from https://console.neon.tech
# Dashboard → your project → Connect → use "Pooled connection" (recommended for Fly/serverless)

NODE_ENV=development
PORT=3001

# Paste your pooled connection string (must include sslmode=require):
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Neon: smaller pool on free tier; idle release reduces connection minutes
DB_POOL_MAX=5
DB_POOL_IDLE_TIMEOUT_MS=30000

# Comment out or remove local DB_* when using DATABASE_URL
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=forge
# DB_PASSWORD=forge_local_password
# DB_NAME=forge_db

# Redis — Redis Cloud (see apps/api/.env.redis-cloud.example) or local Docker
# REDIS_URL=redis://default:PASSWORD@YOUR-HOST.db.redis.io:13195

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
