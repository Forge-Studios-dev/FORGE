# Public API URL (client-side)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Production (Vercel): https://api.forgestudios.net/api/v1

# Internal API URL (server-side SSR, optional, defaults to NEXT_PUBLIC_API_URL).
# When using full `docker compose up` (web in Docker, API as service `api`), set this to http://api:3001/api/v1
# so SSR can reach the API; keep NEXT_PUBLIC_API_URL on http://localhost:3001/api/v1 for the browser.
API_INTERNAL_URL=http://localhost:3001/api/v1

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://forgestudios.net

# Comma-separated client feature flags (merged with API GET /platform/config)
# NEXT_PUBLIC_FEATURE_FLAGS=blueprints_public

# Sentry (optional)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_SEND_DEFAULT_PII=false  # recommended for production (F-803)

# LiveKit browser go-live (must match API LIVEKIT_URL host)
# NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Stripe membership checkout (must match API BILLING_PROVIDER=stripe)
# NEXT_PUBLIC_BILLING_ENABLED=true

# Firebase client (FCM + App Check — optional)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# NEXT_PUBLIC_APP_CHECK_SITE_KEY=
