# Copy to secrets/auth-deploy.env (gitignored) and fill values.
# Then: bash scripts/deploy-auth-secrets.sh

# --- Google OAuth (Google Cloud Console → OAuth Web client) ---
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_OAUTH_CALLBACK_URL=https://api.forgestudios.net/api/v1/auth/google/callback
WEB_OAUTH_SUCCESS_URL=https://forgestudios.net/auth/oauth/callback
WEB_URL=https://forgestudios.net

# --- Email (Resend) — API key from https://resend.com/api-keys (starts with re_) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_YOUR_RESEND_API_KEY
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
MAIL_FROM=noreply@forgestudios.net
# Resend → Domains: verify forgestudios.net before using MAIL_FROM above

# --- Email verification OTP (6-digit code in verification email; requires Redis) ---
AUTH_EMAIL_OTP_ENABLED=true

# --- Firebase Admin (FCM push — NOT Firebase Auth login) ---
# Production GCP project: forge-studios-prod (enable Firebase in Console first — see FIREBASE_CONNECTION_BLOCKER.md)
FIREBASE_PROJECT_ID=forge-studios-prod-61de0
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@forge-studios-prod-61de0.iam.gserviceaccount.com
# Paste private key with literal \n for newlines (Fly-compatible)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FCM_ENABLED=true
APP_CHECK_ENABLED=false

# Vercel web only (Firebase Console → Cloud Messaging → Web Push certificates → Key pair):
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=aaZ7DAg6Lk4nx3aT4HlCVenL-PZkaM8RLiwDP0omYFM
