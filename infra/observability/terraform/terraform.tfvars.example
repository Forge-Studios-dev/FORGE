# Copy to terraform.tfvars — do not commit.

stack_slug = "forgesupport"

# Grafana Cloud → Administration → Cloud access policies
# Scopes: stack read + Connections / Metrics Endpoint (see policy docs for your org)
grafana_cloud_access_policy_token = ""

# Same as Fly METRICS_SCRAPE_TOKEN:
#   SHOW_SCRAPE_TOKEN=1 npm run configure:grafana-scrape
metrics_scrape_token = ""

# Optional — auto-filled from stack when empty:
# connections_api_url = ""
