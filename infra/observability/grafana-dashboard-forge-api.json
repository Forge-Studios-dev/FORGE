{
  "title": "FORGE API",
  "uid": "forge-api",
  "tags": ["forge", "api"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-forgesupport-prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "grafanacloud-forgesupport-prom" },
          "expr": "sum(rate(forge_http_requests_total[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-forgesupport-prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "grafanacloud-forgesupport-prom" },
          "expr": "histogram_quantile(0.95, sum(rate(forge_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "stat",
      "title": "5xx rate (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-forgesupport-prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "grafanacloud-forgesupport-prom" },
          "expr": "sum(rate(forge_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(forge_http_requests_total[5m]))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    }
  ]
}
