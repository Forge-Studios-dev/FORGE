{
  "name": "@forge/shared-types",
  "version": "1.0.0",
  "private": true,
  "description": "Shared TypeScript types for FORGE apps (extend as APIs stabilize)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./access": {
      "types": "./dist/access.d.ts",
      "require": "./dist/access.js",
      "default": "./dist/access.js"
    },
    "./jwt": {
      "types": "./dist/jwt.d.ts",
      "require": "./dist/jwt.js",
      "default": "./dist/jwt.js"
    },
    "./consumer-session": {
      "types": "./dist/consumer-session.d.ts",
      "require": "./dist/consumer-session.js",
      "default": "./dist/consumer-session.js"
    },
    "./safe-return-path": {
      "types": "./dist/safe-return-path.d.ts",
      "require": "./dist/safe-return-path.js",
      "default": "./dist/safe-return-path.js"
    },
    "./security-headers": {
      "types": "./dist/security-headers.d.ts",
      "require": "./dist/security-headers.js",
      "default": "./dist/security-headers.js"
    },
    "./cors-origins": {
      "types": "./dist/cors-origins.d.ts",
      "require": "./dist/cors-origins.js",
      "default": "./dist/cors-origins.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "require": "./dist/analytics.js",
      "default": "./dist/analytics.js"
    },
    "./platform-public-config": {
      "types": "./dist/platform-public-config.d.ts",
      "require": "./dist/platform-public-config.js",
      "default": "./dist/platform-public-config.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest --passWithNoTests"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json", "node"]
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.4.4"
  }
}
